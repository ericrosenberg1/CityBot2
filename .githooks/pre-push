#!/usr/bin/env bash
# Runs the gates that used to run in GitHub Actions, before the push lands,
# after infra-leak-guard checks the pushed commits for private infra details.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
"$top/.githooks/infra-leak-guard.sh" --pre-push --remote "${1:-origin}"
exec "$top/scripts/ci-gates.sh"
